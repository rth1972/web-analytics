generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String
  role             Role      @default(USER)
  emailVerified    Boolean   @default(false)
  emailVerifyToken String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  approved         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  websites      Website[]
  loginAttempts LoginAttempt[]

  @@index([username])
  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  email     String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@map("invite_tokens")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  ip        String
  username  String
  success   Boolean
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, createdAt])
  @@map("login_attempts")
}

model Website {
  id        String   @id @default(uuid())
  name      String
  domain    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  pageViews PageView[]
  sessions  Session[]
  events    Event[]

  @@index([id])
  @@index([userId])
  @@map("websites")
}

model PageView {
  id         String   @id @default(uuid())
  websiteId  String
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page       String
  referrer   String?
  userAgent  String?
  country    String?
  city       String?
  device     String?
  browser    String?
  os         String?
  screenSize String?
  ipAddress  String?
  sessionId  String
  timestamp  DateTime @default(now())

  @@index([websiteId])
  @@index([timestamp])
  @@index([sessionId])
  @@map("pageviews")
}

model Event {
  id        String   @id @default(uuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  data      String?
  sessionId String
  timestamp DateTime @default(now())

  @@index([websiteId])
  @@index([timestamp])
  @@map("events")
}

model Session {
  id          String    @id @default(uuid())
  websiteId   String
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fingerprint String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  startTime   DateTime  @default(now())
  endTime     DateTime?
  pageViews   Int       @default(0)

  @@index([websiteId])
  @@index([startTime])
  @@map("sessions")
}
